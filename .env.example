# PostgreSQL connection strings.
#
# DATABASE_URL: what the app uses at runtime. If your provider has a
# connection pooler (Supabase, PgBouncer), point this at the POOLED port.
# DIRECT_URL: what Prisma uses for migrations. Must be a direct (non-pooled)
# connection — pooled connections don't support the prepared statements
# `prisma migrate` needs.
#
# Neon / Vercel Postgres / plain Postgres (no pooler): set both to the same value.
#   DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/thimphu?sslmode=require"
#   DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/thimphu?sslmode=require"
#
# Supabase: DATABASE_URL uses the pooler port (6543), DIRECT_URL uses the direct port (5432).
#   DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://user:password@localhost:5432/thimphu"
DIRECT_URL="postgresql://user:password@localhost:5432/thimphu"

# Shared PIN/passphrase used to unlock the app for both Chino and Rosario.
# Pick something only the two of you know. Not meant to be enterprise-grade security.
APP_PIN="change-me"

# Random long secret used to sign the session cookie (HMAC). Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-too-please-generate-a-random-32-byte-hex-string"
